{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "v2-to-v1 mapping pack schema",
  "description": "Schema for the index file and route files in the v2-to-v1 mapping pack. All schemas use additionalProperties: false.",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stepEntry": {
      "type": "object",
      "required": ["method", "path", "step"],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "linked_by": {
          "type": "object",
          "required": ["from_field", "from_step", "param"],
          "additionalProperties": false,
          "properties": {
            "from_field": { "type": "string", "minLength": 1 },
            "from_step": { "type": "string", "minLength": 1 },
            "param": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "limitationBlock": {
      "type": "object",
      "required": ["kind", "note"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "not_supported_public",
            "differs_from_v2",
            "header_not_supported",
            "fields_not_available",
            "paging_not_controllable",
            "grammar_limited",
            "handled_implicitly"
          ]
        },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "targetBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "in": { "type": "string" },
        "operation": { "type": "string" },
        "param": { "type": "string", "minLength": 1 },
        "public_type": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "minLength": 1 }
          }
        },
        "step": { "type": "string", "minLength": 1 },
        "step_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "public_type": { "type": "string", "minLength": 1 }
            }
          }
        },
        "transform": { "type": "string", "minLength": 1 }
      }
    },
    "gqlViaBlock": {
      "type": "object",
      "required": ["disposition", "note", "pointer", "v2"],
      "additionalProperties": false,
      "properties": {
        "computed_from": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disposition": { "type": "string", "const": "confirmed_via_graphql" },
        "graphql_alternative": { "type": "string", "minLength": 1 },
        "mapping_hint": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "pointer": { "type": "string", "minLength": 1 },
        "v2": { "type": "string", "minLength": 1 },
        "v2_type": { "type": "string", "minLength": 1 }
      }
    },
    "confirmedItem": {
      "type": "object",
      "required": ["disposition", "v2"],
      "additionalProperties": false,
      "properties": {
        "computed_from": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disposition": { "type": "string", "const": "confirmed" },
        "graphql_alternative": { "type": "string", "minLength": 1 },
        "mapping_hint": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/targetBlock" },
        "v2": { "type": "string", "minLength": 1 },
        "v2_type": { "type": "string", "minLength": 1 }
      }
    },
    "limitationItem": {
      "type": "object",
      "required": ["disposition", "limitation", "v2"],
      "additionalProperties": false,
      "properties": {
        "computed_from": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disposition": { "type": "string", "const": "limitation" },
        "graphql_alternative": { "type": "string", "minLength": 1 },
        "limitation": { "$ref": "#/$defs/limitationBlock" },
        "mapping_hint": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/targetBlock" },
        "v2": { "type": "string", "minLength": 1 },
        "v2_type": { "type": "string", "minLength": 1 }
      }
    },
    "notOnRouteItem": {
      "type": "object",
      "required": ["disposition", "v2"],
      "additionalProperties": false,
      "properties": {
        "computed_from": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "disposition": { "type": "string", "const": "not_on_route" },
        "graphql_alternative": { "type": "string", "minLength": 1 },
        "mapping_hint": { "type": "string", "minLength": 1 },
        "pointer": { "type": ["string", "null"] },
        "v2": { "type": "string", "minLength": 1 },
        "v2_type": { "type": "string", "minLength": 1 }
      }
    },
    "unsupportedItem": {
      "type": "object",
      "required": ["kind", "note", "v2"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "v2": { "type": "string", "minLength": 1 }
      }
    },
    "routeItem": {
      "oneOf": [
        { "$ref": "#/$defs/confirmedItem" },
        { "$ref": "#/$defs/limitationItem" },
        { "$ref": "#/$defs/gqlViaBlock" },
        { "$ref": "#/$defs/notOnRouteItem" }
      ]
    },
    "errorsBlock": {
      "type": "object",
      "required": ["cases", "route", "v2"],
      "additionalProperties": false,
      "properties": {
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["situation", "v2"],
            "additionalProperties": true,
            "properties": {
              "migration_note": { "type": ["string", "null"] },
              "situation": { "type": "string", "minLength": 1 },
              "v2": { "type": "string", "minLength": 1 }
            }
          }
        },
        "route": {
          "type": "object",
          "required": ["body", "retry_signal"],
          "additionalProperties": false,
          "properties": {
            "body": { "type": "string", "minLength": 1 },
            "retry_signal": { "type": "string", "minLength": 1 }
          }
        },
        "v2": {
          "type": "object",
          "required": ["body", "retry_signal"],
          "additionalProperties": false,
          "properties": {
            "body": { "type": "string", "minLength": 1 },
            "retry_signal": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "routeFile": {
      "type": "object",
      "required": ["errors", "id", "request", "response", "route", "steps", "unsupported"],
      "additionalProperties": false,
      "properties": {
        "errors": { "$ref": "#/$defs/errorsBlock" },
        "id": { "type": "string", "minLength": 1 },
        "request": {
          "type": "array",
          "items": { "$ref": "#/$defs/routeItem" }
        },
        "response": {
          "type": "array",
          "items": { "$ref": "#/$defs/routeItem" }
        },
        "route": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stepEntry" }
        },
        "unsupported": {
          "type": "array",
          "items": { "$ref": "#/$defs/unsupportedItem" }
        }
      }
    },
    "indexCard": {
      "type": "object",
      "required": ["files", "id", "map_digest", "recommended_route", "routes", "v2"],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "id": { "type": "string", "minLength": 1 },
        "map_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "recommended_route": {
          "type": "object",
          "required": ["api", "rationale"],
          "additionalProperties": false,
          "properties": {
            "api": { "type": "string", "minLength": 1 },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "v2": {
          "type": "object",
          "required": ["method", "operation_id", "path"],
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "operation_id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "indexFile": {
      "type": "object",
      "required": ["cards", "changelog", "generator", "pack_version", "spec_version"],
      "additionalProperties": false,
      "properties": {
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/indexCard" }
        },
        "changelog": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["date", "description", "version"],
            "additionalProperties": false,
            "properties": {
              "date": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        },
        "generator": { "type": "string", "minLength": 1 },
        "pack_version": { "type": "string", "minLength": 1 },
        "spec_version": { "type": "string", "minLength": 1 }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/indexFile" },
    { "$ref": "#/$defs/routeFile" }
  ]
}
