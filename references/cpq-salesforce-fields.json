{
  "$description": "Static fallback catalog of Zuora CPQ and Zuora Billing Salesforce object fields. Used by CPQ build/validate skills and lint-cpq-apex.js / lint-cpq-hooks-events.js when live SFDX describe is unavailable. Customer-specific custom fields outside zqu__/Zuora__ namespaces are not listed.",
  "$source": "references/cpq-patterns.md — Required Fields for renewQuote, Field Mapping Template, SOQL Query Requirements (snapshot 2026-Q1).",
  "$usage": {
    "lookup": "objects.<ObjectApiName>.fields[]",
    "requiredFor": "objects.<ObjectApiName>.requiredFor.<flow> — fields that must appear in SOQL SELECT before calling the flow API",
    "commonMistakes": "$common_mistakes — known hallucinated field names mapped to corrections",
    "linterRules": {
      "EAPEX050": "literal type incompatible with catalog field type",
      "EAPEX052": "known hallucinated field name ($common_mistakes)",
      "WAPEX050": "zqu__/Zuora__ field not in catalog",
      "WAPEX051": "renewQuote flow missing required SELECT fields",
      "WJS080": "Quote Studio patch/getQuoteField references unknown zqu__ field"
    }
  },
  "$common_mistakes": {
    "Zuora_ZuoraId__c": "Use Zuora__Zuora_Id__c",
    "Zuora_ZuoraID__c": "Use Zuora__Zuora_Id__c",
    "Zuora__ZuoraId__c": "Use Zuora__Zuora_Id__c",
    "zqu__BillingAccount__c": "Deprecated — use zqu__ZuoraAccountId__c",
    "zqu__SubscriptionId__c": "Use zqu__ExistSubscriptionID__c with the Zuora subscription Id, not the Salesforce record Id",
    "Quote__c": "Use zqu__Quote__c (managed package namespace prefix)"
  },
